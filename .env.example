# aipsy-bench — provider API keys (YOUR keys, YOUR cost).
#
# Copy this file to `.env` and fill in the keys for the judges you'll use. aipsy-bench
# never stores, transmits, or proxies your keys — they are read from your environment
# and used to call the providers directly, so the provider bills you, not us.
#
#   cp .env.example .env      # then edit .env  (it is gitignored — never commit it)
#
# Precedence: a variable already exported in your shell wins over .env.
# `--judges single` (default) needs only OPENAI_API_KEY. `--judges gold` needs all three.
# `--target mock` and the test suite need NO keys at all (offline).
# Check what's set for your panel:  aipsy-bench doctor --judges gold

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
